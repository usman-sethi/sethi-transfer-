# Sethi Transfer Environment Configuration

# Server Port (Required for AI Studio dev server)
PORT=3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sethi_transfer?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/sethi_transfer"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# JWT Secrets for Authentication
JWT_ACCESS_SECRET="your_super_secret_jwt_access_key_minimum_32_characters_long"
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key_minimum_32_characters_long"

# Host URL
APP_URL="http://localhost:3000"
